BOT_TOKEN=токен_telegram_бота
ADMIN_ID=123456789
DB_PATH=wbbot.db

# ---- Аккаунт WB №1 ----
WB_TOKEN=токен_wb_категории_Маркетплейс_и_Контент
# название в боте (необязательно)
WB_NAME="Магазин А"
# имя на стикере штрихкода (необязательно; иначе берётся из API WB)
SELLER_NAME="ИП Иванов И. И."
# пункт отгрузки (если задан, бот установит параметры отгрузки перед передачей в доставку)
SHIPPING_POINT_ID=
SHIPPING_TYPE=selfShipping
# дата отгрузки: сегодня (по Москве) + N дней
SHIPPING_DAYS=0

