BOT_TOKEN=токен_telegram_бота
DB_PATH=wbbot.db

# Ключ шифрования токенов WB в базе. Необязательно: если не задан, создаётся файл secret.key рядом
# с базой (в Docker — data/secret.key). Ключ и база должны храниться вместе: без ключа токены не прочитать.
# ENCRYPTION_KEY=
# Максимум магазинов на одного пользователя
# MAX_STORES=5

# ---- Только для переноса «старых» аккаунтов (необязательно) ----
# Если база магазинов пуста, аккаунты ниже при запуске переносятся владельцу ADMIN_ID.
# Дальше магазины привязываются прямо в боте, а эти строки можно удалить.
ADMIN_ID=123456789
WB_TOKEN=
# WB_NAME="Магазин А"
# SELLER_NAME="ИП Иванов И. И."
# SHIPPING_POINT_ID=
# SHIPPING_TYPE=selfShipping
# SHIPPING_DAYS=0
# WB_TOKEN_2=
# WB_NAME_2="Магазин Б"
